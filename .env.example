# Required -----------------------------------------------------------------
# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your own chat id - message your bot once, then run ./get_chat_id.sh
TELEGRAM_CHAT_ID=

# Alerting -----------------------------------------------------------------
# Fire when an offer's premium is at or below this, in percent.
MAX_PREMIUM_PCT=20

# Ignore anything smaller than this. IMPORTANT: the book is full of sub-1 USDC
# dust posted at 0-20% premium that you can't meaningfully trade. Without this
# filter you will be alerted constantly and none of it will be real.
MIN_SIZE_USDC=10

# Which side of the desk to watch: buy, sell, or buy,sell
#   buy  = you pay on Ethereum, receive USDC on Arc
#   sell = you pay on Arc, receive USDC on Ethereum
MARKETS=buy

# Timing -------------------------------------------------------------------
POLL_SECONDS=60      # the site's own UI refreshes every 15s; 60 is polite
REALERT_HOURS=6      # don't re-nag about the same offer more often than this
FORGET_MINUTES=60    # offer off the book this long counts as new if reposted
ANNOUNCE_START=1     # send a quiet "watcher started" message on boot
